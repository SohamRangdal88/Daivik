# ── NyayaDepaaAI Auth Backend — Environment Variables ──

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Extra CORS origins (comma-separated). Add your Vercel domain(s) here.
# Example: ALLOWED_ORIGINS=https://nyayadepaaai.vercel.app,https://www.nyayadepaaai.com
ALLOWED_ORIGINS=

# Required secrets and database configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
JWT_SECRET_KEY=replace-with-a-long-random-secret
# ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
